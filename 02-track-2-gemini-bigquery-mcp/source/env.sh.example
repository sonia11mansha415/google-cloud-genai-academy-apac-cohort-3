# Copy to env.sh locally if desired. Do NOT commit env.sh if you customize it with private values.
# Cloud Project ID and Cloud Run region
export GOOGLE_CLOUD_PROJECT="${GOOGLE_CLOUD_PROJECT:-YOUR_PROJECT_ID}"
export GOOGLE_CLOUD_REGION="${GOOGLE_CLOUD_REGION:-us-central1}"

# Gemini API in Agent Platform
export GOOGLE_GENAI_USE_ENTERPRISE="True"
export GOOGLE_CLOUD_LOCATION="global"
